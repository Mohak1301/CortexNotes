# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS (Update with your Vercel frontend URL)
FRONTEND_URL=http://localhost:3000
# Comma-separated in production when multiple trusted frontends are used
# FRONTEND_URLS=https://app.example.com,https://www.example.com

# Supabase Auth (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Use `lax` for same-site deployments. If the frontend and API use unrelated
# domains, use `none` together with HTTPS and AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=.example.com

# Set true only when deployed behind one trusted reverse proxy.
TRUST_PROXY=false

# Abuse controls (per process; use a shared gateway/Redis limiter for multi-instance deployments)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
EXPENSIVE_RATE_LIMIT_MAX=12
MAX_PDF_BYTES=10485760
MAX_TEXT_CHARS=200000
MAX_CHAT_CHARS=4000
MAX_WEB_BYTES=2097152
MAX_EXTRACTED_CHARS=1000000
REQUEST_TIMEOUT_MS=30000

# Qdrant Cloud Configuration
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION_NAME=your-collection-name
