# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/cortexnotes

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_here_make_it_long_and_random
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here_make_it_long_and_random

# Qdrant Cloud Configuration
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key
